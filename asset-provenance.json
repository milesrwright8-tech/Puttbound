    "expected": {
      "approvedRevision": 3,
      "blueprintId": "gbp_2e024286d60ddb0ad0d0792d",
      "digest": "bffa5e2501a83b890f5f05d764c4c1be21d92cecfdedf3f121bdb333f27ba1c8",
      "roles": [
        {
          "description": "Your game needs a readable stylized 3D ball and unmistakable cup target, with local player-color variants and satisfying strike, trail, impact, cup-entry, hole-in-one, and completion feedback.",
          "id": "ball-cup-goal-set",
          "label": "Putting ball, cup, flag, and goal feedback set"
        },
        {
          "description": "Your 30 holes need cohesive low-poly 3D fairways, walls, curves, slopes, ramps, loops, tunnels, bridges, platforms, gaps, boundaries, and multi-level connectors that clearly separate playable surfaces from hazards.",
          "id": "modular-course-kit",
          "label": "Modular playable course construction kit"
        },
        {
          "description": "Your courses need readable animated windmills, swinging barriers, gates, sliding walls, rotating platforms, elevators, conveyors, and bumpers with predictable collision silhouettes and motion.",
          "id": "moving-obstacle-kit",
          "label": "Moving obstacle and machinery kit"
        },
        {
          "description": "Your advanced holes need visually clear launchers, cannons, launch pads, fixed teleport-pad pairs, curved ramps, landing targets, and route indicators that communicate behavior before each shot.",
          "id": "trick-shot-devices",
          "label": "Trick-shot and transport device kit"
        },
        {
          "description": "Your game needs clear 3D treatment for water, out-of-bounds edges, safe platforms, risky shortcuts, checkpoints, reset positions, and valid landing zones without relying on generic final placeholders.",
          "id": "hazard-recovery-language",
          "label": "Hazard, checkpoint, and recovery visual language"
        },
        {
          "description": "Your five worlds need cohesive gameplay-relevant props: park wood and grass features, candy bumpers, neon arcade machinery, pirate decks and barrels, and space-station platforms and mechanisms.",
          "id": "five-world-gameplay-props",
          "label": "Five-world gameplay prop families"
        },
        {
          "description": "Your game needs mobile-friendly trails, collision bursts, bounce cues, moving-surface signals, teleport and launcher effects, goal celebration, personal-best feedback, and readable active/inactive states.",
          "id": "gameplay-effects",
          "label": "Restrained gameplay effects and material states"
        },
        {
          "description": "Your local multiplayer needs clearly distinguishable ball colors and turn emphasis that remain legible under every world’s lighting while preserving one premium-casual style.",
          "id": "player-color-variants",
          "label": "Pass-and-play player color variants"
        }
      ]
    },
    "overflowEvents": 0,
    "resolutions": {},
    "version": 1
  }
